// more or equal than 90% Diskspace used (Unix)
let VMs = arg("").Resources
    | where type in~ ("microsoft.compute/virtualmachines", "microsoft.hybridcompute/machines", "microsoft.compute/virtualmachinescalesets")
    | where tags.alerting =~ "enabled"
    | where tolower(properties.storageProfile.osDisk.osType) == "linux"
    | extend ResourceId = tolower(id)
    | project ResourceId;
let mountpoints = dynamic(["/", "/var", "/boot", "/tmp", "/home", "/opt", "/backup", "/boot/efi"]);
let warning = int(80);
let critical = int(90);
InsightsMetrics
    //| where TimeGenerated >= ago(5m) // Uncomment this line to only check the last "n" minutes/hours/days of data
    | where Namespace == "LogicalDisk"
    | where Name == "FreeSpacePercentage"
    | extend Mountpoint = tostring(parse_json(Tags)["vm.azm.ms/mountId"])
    | where Mountpoint in (mountpoints)
    | extend UsedPercentage = 100 - Val
    | where UsedPercentage >= warning
    | extend ResourceId = tolower(_ResourceId)
    | summarize arg_max(TimeGenerated, *) by ResourceId, affected_object = toupper(tostring(split(ResourceId, "/")[-1])), Mountpoint
    | project ResourceId, affected_object, UsedPercentage, Mountpoint, TimeGenerated
| join kind=inner hint.remote=left (
    VMs
) on ResourceId
| extend state = case(UsedPercentage >= critical, "Critical", UsedPercentage >= warning and UsedPercentage < critical, "Warning", "OK")
| extend threshold = case(UsedPercentage >= critical, critical, UsedPercentage >= warning and UsedPercentage < critical, warning, 0)
| extend monitor_description = strcat("Disk threshold has been reached. Used disk space is ", tostring(threshold), "%. Please, check the Diskspace.")
| extend value = round(UsedPercentage, 2)
| extend additional_information = strcat("Used disk space: ", tostring(value), "%.")
| extend affected_entity = Mountpoint
| project ResourceId, TimeGenerated, state, affected_object, threshold, value, affected_entity, monitor_description, additional_information